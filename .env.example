# Copy to .env for local development. `pnpm db:dev` (or `pnpm dev`) writes a
# working .env automatically when none exists.

# Application role: subject to Row Level Security, NOT the table owner.
DATABASE_URL=postgres://cleitext_app:change-me@127.0.0.1:5432/cleitext
# Owner role: used only for migrations and administrative commands.
DATABASE_ADMIN_URL=postgres://cleitext_owner:change-me@127.0.0.1:5432/cleitext

# HOST=127.0.0.1
# PORT=3000
# DATABASE_POOL_MAX=10
# LOG_LEVEL=info
# TRUST_PROXY=false   # true behind nginx / Plesk
# SESSION_TTL_HOURS=12        # session without "remember me"
# SESSION_REMEMBER_DAYS=30    # session with "remember me"

# Outgoing mail: smtp://user:pass@host:587, smtps://..., log:// (print to the log) or memory://
# MAIL_URL=log://
# MAIL_FROM=Cleitext <no-reply@example.com>

# Uploaded files (disk storage). Relative to the server's working directory.
# MEDIA_PATH=cleitext-data/media
# MEDIA_MAX_BYTES=20971520
# SVG uploads, sanitized (scripts, styles and external links removed). Off by default.
# MEDIA_ALLOW_SVG=false
# How often scheduled entries are published (seconds; 0 disables it).
# SCHEDULER_INTERVAL_SECONDS=60

# Secret for signed links (draft previews). Required in production: at least
# 32 random characters, e.g. `openssl rand -hex 32`.
# APP_SECRET=
# Public page cache (in memory, per process). 0 entries disables it.
# PAGE_CACHE_MAX_ENTRIES=5000
# PAGE_CACHE_TTL_SECONDS=3600
# Installed plugins (written by `cleitext plugin:install`, read by the server).
# PLUGINS_PATH=cleitext-data/plugins
# Installed themes (cleitext theme:install); Aurora is always available.
# THEMES_PATH=cleitext-data/themes

# Setup wizard (no configuration yet): also ask for a setup token, printed in
# the log and kept in tmp/setup-token. Off by default: install right away.
# CLEITEXT_SETUP_TOKEN=true

# Core updates from the admin (Updates): where the releases are on GitHub.
# Empty turns the update check off.
# UPDATES_REPO=faghy/cleitext
# Plugins → Add New and Themes → Add New read this signed catalog (empty: turned off).
# CATALOG_URL=https://github.com/faghy/cleitext-catalog/releases/download/catalog/catalog.json
# CATALOG_PUBLIC_KEY=   (Ed25519, SPKI DER in base64; the official key is built in)
