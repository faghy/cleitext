{
  "name": "@cleitext/db",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@cleitext/shared": "workspace:*",
    "@cleitext/testing": "workspace:*",
    "drizzle-kit": "^0.31.11"
  }
}
