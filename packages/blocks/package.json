{
  "name": "@cleitext/blocks",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "default": "./dist/html.js"
    },
    "./transfer": {
      "types": "./dist/transfer.d.ts",
      "default": "./dist/transfer.js"
    },
    "./inline": {
      "types": "./dist/inline-entry.d.ts",
      "default": "./dist/inline-entry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/**' --coverage.thresholds.lines=90 --coverage.thresholds.statements=90 --coverage.thresholds.functions=88 --coverage.thresholds.branches=80"
  },
  "dependencies": {
    "node-html-parser": "^9.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  }
}
