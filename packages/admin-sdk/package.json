{
  "name": "@cleitext/admin-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "Admin toolkit shared by the Cleitext admin and plugin admin pages.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/layout-fields.ts' --coverage.include='src/block-fields.ts' --coverage.include='src/field-types.tsx' --coverage.include='src/code-editor.tsx' --coverage.include='src/code-editor-view.ts' --coverage.thresholds.lines=90 --coverage.thresholds.statements=90 --coverage.thresholds.functions=85 --coverage.thresholds.branches=80"
  },
  "dependencies": {
    "@cleitext/blocks": "workspace:*",
    "@cleitext/shared": "workspace:*",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3"
  }
}
