{
  "name": "@cleitext/admin-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "Admin toolkit shared by the Cleitext admin and plugin admin pages.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/layout-fields.ts' --coverage.include='src/block-fields.ts' --coverage.include='src/field-types.tsx' --coverage.thresholds.lines=90 --coverage.thresholds.statements=90 --coverage.thresholds.functions=85 --coverage.thresholds.branches=80"
  },
  "dependencies": {
    "@cleitext/blocks": "workspace:*",
    "@cleitext/shared": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3"
  }
}
