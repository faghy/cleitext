    "notifications": {
      "enabled": true,
      "notifications": [
        {
          "appointment_types": [],
          "id": 1,
          "schema": "2019-04-02",
          "sent_to": ["{{admin_email}}"],
          "title": "Email (Admin)",
          "subject": "{{ Appointment.customer_information.Name }} ha prenotato",
          "message": "<p>{{ Appointment.customer_information.Name }} ha prenotato su {{ Global.home_url }}</p>\n<p>Dettagli cliente: <br>\n{{ Appointment.customer_information_summary }}</p>\n",
          "trigger": "appointment_booked",
          "type": "email",
          "when": "after",
          "duration": 0
        },
        {
          "appointment_types": [],
          "id": 2,
          "schema": "2019-04-02",
          "sent_to": ["{{customer_email}}"],
          "title": "Email (Customer)",
          "subject": "Conferma del tuo appuntamento",
          "message": "<p class=\"x\">Gentile {{ Appointment.customer_information.Name }},</p><p>la prenotazione è confermata.</p><p><strong>Data e ora:</strong> {{ Appointment.customer_start_date }}</p><p><strong>Tipo:</strong> {{ Appointment.AppointmentType.title|raw }}</p><p>{% if instructions %}<br>\nIstruzioni: {{ instructions|raw }}<br>\n{% endif %}</p><p>Modulo: <a href=\"https://example.test/modulo\">compila il modulo</a> &amp; firma</p><p>Saluti,<br><strong>{{ Global.company_name }}</strong></p><p>Per modificare: {{ Appointment.public_edit_url }}</p>",
          "trigger": "appointment_booked",
          "type": "email",
          "when": "after",
          "duration": 0
        },
        {
          "appointment_types": [],
          "id": 3,
          "schema": "2019-04-02",
          "sent_to": ["{{admin_email}}", "segreteria@example.test"],
          "title": "Email (Admin)",
          "subject": "Annullato",
          "message": "<p>Annullato</p>",
          "trigger": "appointment_canceled",
          "type": "email",
          "when": "after",
          "duration": 0
        },
        {
          "appointment_types": [],
          "id": 4,
          "schema": "2019-04-02",
          "sent_to": ["{{customer_email}}"],
          "title": "Email (Customer)",
          "subject": "Il tuo appuntamento è stato annullato",
          "message": "<p>Ciao {{ Appointment.customer_information.Name }},<br>il tuo appuntamento di \"{{ Appointment.AppointmentType.title|raw }}\" è stato annullato</p>{% if cancelation_note %}<p>{% if canceled_by_name %} {{ canceled_by_name }} left a note: {% else %}Nota: {% endif %}{{ cancelation_note }} </p>{% endif %}",
          "trigger": "appointment_canceled",
          "type": "email",
          "when": "after",
          "duration": 0
        }
      ]
