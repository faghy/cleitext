{
  "name": "@cleitext/plugin-newletter",
  "version": "1.0.0",
  "private": true,
  "description": "Official Cleitext plugin: NewLetter, signup forms connected to Brevo, Mailchimp, MailerLite, Kit and ActiveCampaign.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "build": "cleitext plugin:build .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/model/**' --coverage.include='src/providers/**' --coverage.include='src/import/**' --coverage.include='src/render.tsx' --coverage.include='src/optin.ts'"
  },
  "devDependencies": {
    "@cleitext/admin-sdk": "workspace:*",
    "@cleitext/cli": "workspace:*",
    "@cleitext/plugin-sdk": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-orm": "^0.45.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3"
  }
}
