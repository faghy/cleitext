<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Coffee</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:quote -->
<blockquote class="wp-block-quote"><!-- wp:paragraph -->
<p>The sea is the same everywhere.</p>
<!-- /wp:paragraph --><cite>A sailor</cite></blockquote>
