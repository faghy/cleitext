		<content:encoded><![CDATA[<!-- wp:paragraph -->
<p>The fishermen come back at <strong>dawn</strong>, see <a href="https://old.example.com/about/">who we are</a>.</p>
<!-- /wp:paragraph -->

<!-- wp:image {"id":10,"sizeSlug":"large"} -->
<figure class="wp-block-image size-large"><img src="https://old.example.com/wp-content/uploads/2024/05/harbour-1024x768.jpg" alt="Boats in the harbour" class="wp-image-10"/><figcaption class="wp-element-caption">Early light</figcaption></figure>
<!-- /wp:image -->

<!-- wp:heading {"level":3} -->
