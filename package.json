{
  "name": "cleitext",
  "private": true,
  "description": "Open-source multi-site CMS modeled on WordPress",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "env -u pnpm_config_verify_deps_before_run turbo run dev",
    "build": "env -u pnpm_config_verify_deps_before_run turbo run build",
    "typecheck": "env -u pnpm_config_verify_deps_before_run turbo run typecheck",
    "test": "env -u pnpm_config_verify_deps_before_run turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @cleitext/db run generate",
    "db:dev": "pnpm --filter @cleitext/dev-db run dev",
    "cleitext": "node --env-file-if-exists=.env packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "fastify": "^5.12.5"
    }
  }
}
